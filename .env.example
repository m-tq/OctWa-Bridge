# Infura API key for Ethereum RPC (optional).
# If not set, falls back to https://ethereum.publicnode.com (no key needed).
# Public RPC is sufficient for read-only calls (balance, eth_call).
# Set this only if you need higher rate limits or private RPC.
VITE_INFURA_API_KEY=

# Octra RPC endpoint — MUST be HTTPS when deployed on HTTPS
# Use Nginx reverse proxy: https://bridge.octwa.pw/rpc → http://46.101.86.250:8080/rpc
# See README.md for Nginx config
VITE_OCTRA_RPC=https://octra.network
